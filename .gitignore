node_modules/
.wrangler/
.dev.vars
*.log

# Python bytecode — a stray poller run under any repo path drops these.
__pycache__/
*.pyc

# Secrets. Note ".env" alone does NOT match "komodo.env" or "backend/.env.local" —
# these patterns are deliberately broader.
.env
*.env
.env.*
!.env.example
komodo.env
secrets.yaml
*.key
*.pem

# Copy to .env and fill in. Nothing is hardcoded — see docs/CONTRACTS.md §3.

# Operator-provided decoded feed (bring your own broker+decoder; or use `--profile broker`).
FEED_MQTT_URL=tcp://mosquitto:1883
FEED_TOPIC=rtl_433/events

# Topic the airmon adapter consumes. Published by adapters/airmon/airmon_poller.py, which
# runs on a host within BLE range of the device (see adapters/airmon/README.md).
AIRMON_TOPIC=airmon/events

# Aggregation window (Telegraf duration: 30s, 5m, 1h...). Drives gateway + Path A cadence.
AGG_PERIOD=5m

# Retention store.
INFLUX_ORG=rf
INFLUX_BUCKET=rf
INFLUX_RETENTION=30d
INFLUX_PASSWORD=change-me
INFLUX_TOKEN=change-me-long-random
# INFLUX_PORT=8086

# Edge sync (leave EDGE_URL empty to run the backend fully standalone).
EDGE_URL=
BRIDGE_TOKEN=
SYNC_PERIOD=60s

# Optional: if the edge /api/bridge/* app is protected by a Cloudflare Access service
# token (recommended — rejects unauthenticated probes at the edge), set both. Leave empty
# if the bridge endpoint uses Access "bypass" and relies on BRIDGE_TOKEN alone.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
